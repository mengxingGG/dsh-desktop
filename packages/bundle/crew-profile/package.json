{
  "name": "@deepseek-ai/dsh-crew-profile",
  "description": "Private profile bundle for the DSH-native Crew workflow",
  "version": "0.1.3-alpha.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/crew-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "presets",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-team": "workspace:^",
    "@deepseek-ai/dsh-crew": "workspace:^",
    "@deepseek-ai/dsh-tool-crew": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@types/js-yaml": "^4.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
