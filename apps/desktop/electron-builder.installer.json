{
  "appId": "ai.deepseek.harness.desktop",
  "productName": "DeepSeek Harness",
  "asar": true,
  "npmRebuild": false,
  "asarUnpack": [
    "**/*.node"
  ],
  "directories": {
    "output": "dist/installers"
  },
  "files": [
    "lib/**/*",
    "renderer/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist/backend",
      "to": "backend"
    }
  ],
  "win": {
    "artifactName": "DeepSeek-Harness-Setup-${version}-${arch}.${ext}",
    "target": ["nsis"]
  },
  "linux": {
    "artifactName": "DeepSeek-Harness-${version}-${arch}.${ext}",
    "category": "Development",
    "target": ["deb"]
  }
}
